{
  "expo": {
    "name": "FOTOMAC",
    "slug": "fotomac",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fotomac",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "lang": "pt-BR"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-audio",
      "expo-sharing",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "O FOTOMAC usa a câmera para a captura rápida do seu rosto na busca das suas fotos, e para o fotógrafo da equipe fotografar um evento. Nenhum vídeo é gravado na busca e os quadros são apagados logo depois.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O FOTOMAC usa a galeria só quando a equipe escolhe fotos e vídeos para enviar a um evento.",
          "cameraPermission": "O FOTOMAC usa a câmera para a equipe fotografar ou gravar um evento e enviar as imagens.",
          "microphonePermission": "O FOTOMAC usa o microfone só quando a equipe grava um vídeo de um evento."
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
